# forge-control repo — versions ONLY the forge control plane
# (CLAUDE.md, agents/, tasks/, questions/, .claude/, tests/Features/)
#
# All 11 application sub-repos and orphan tooling are excluded so this repo
# never accidentally swallows code from another git repo.

# 1. Ignore everything by default
*

# 2. Re-include forge control plane
!.gitignore
!CLAUDE.md
!MEMORY.md

!.claude/
!.claude/**
# never commit machine-local Claude settings
.claude/settings.local.json

!agents/
!agents/**

!tasks/
!tasks/**

!Docs
!Docs/**

!questions/
!questions/**

# .feature files are PO property (CLAUDE.md rule 1a) — keep them under forge-control
!tests/
tests/*
!tests/Features/
!tests/Features/**
# Playwright e2e tests (cross-repo, scaffolded by /qa) — track config + specs,
# leave node_modules / playwright-report / test-results to E2E's own .gitignore.
!tests/E2E/
!tests/E2E/**
tests/E2E/node_modules/
tests/E2E/playwright-report/
tests/E2E/test-results/
tests/E2E/blob-report/
tests/E2E/playwright/.cache/

# Belt-and-braces: never track anything inside the 11 application sub-repos,
# even if a future glob change re-includes them.
Api/
Client/
Dtos/
Sdk/
Host/
DevOps/
interop/
psc/
Tools/
